<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ProcesoEditorial"
                  name="Proceso editorial de publicaciones científicas"
                  targetNamespace="http://gpc.unl.edu.ec/bpmn/proceso-editorial"
                  exporter="Gestión de Publicaciones Científicas"
                  exporterVersion="1.0">

  <bpmn:collaboration id="Collaboration_Editorial">
    <bpmn:participant id="Participant_Editorial" name="Proceso editorial"
                      processRef="Process_Editorial" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Editorial" name="Proceso editorial" isExecutable="false">
    <bpmn:documentation>Ciclo de vida de un manuscrito: del envío del Autor al veredicto del Editor, con la evaluación doble ciego del Revisor y el plazo de 20 días calendario. Las tareas se nombran con el verbo en infinitivo.</bpmn:documentation>

    <bpmn:laneSet id="LaneSet_Editorial">
      <bpmn:lane id="Lane_Autor" name="Autor">
        <bpmn:flowNodeRef>Start_Someter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjuntarPdf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditarMetadatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NuevaVersion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Task_ValidarPdf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuditarNotificar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Editor" name="Editor">
        <bpmn:flowNodeRef>Task_RevisarEnvio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PasarRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Asignar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarEvaluacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Veredicto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Publicado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Revisor" name="Revisor">
        <bpmn:flowNodeRef>SubProcess_Evaluar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Plazo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Autor -->
    <bpmn:startEvent id="Start_Someter" name="Decidir someter un manuscrito">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Registrar" name="Registrar manuscrito">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AdjuntarPdf" name="Adjuntar PDF">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Enviar" name="Enviar manuscrito">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Sistema -->
    <bpmn:serviceTask id="Task_ValidarPdf" name="Validar PDF y sellar versión">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_Reenvio</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AuditarNotificar" name="Registrar auditoría y notificar">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Editor -->
    <bpmn:task id="Task_RevisarEnvio" name="Revisar envío">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PasarRevision" name="Pasar a revisión">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Asignar" name="Seleccionar y asignar revisor">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_Reasignar</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Revocar" name="Revocar asignación">
      <bpmn:incoming>Flow_Vencido</bpmn:incoming>
      <bpmn:outgoing>Flow_Reasignar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RevisarEvaluacion" name="Revisar evaluación">
      <bpmn:incoming>Flow_Evaluado</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Veredicto" name="Registrar veredicto">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decisión" default="Flow_Correcciones">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Aceptado</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rechazado</bpmn:outgoing>
      <bpmn:outgoing>Flow_Correcciones</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Publicado" name="Publicar en el catálogo">
      <bpmn:incoming>Flow_Aceptado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rechazado" name="Archivar manuscrito">
      <bpmn:incoming>Flow_Rechazado</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Autor: respuesta a las correcciones -->
    <bpmn:task id="Task_EditarMetadatos" name="Editar metadatos">
      <bpmn:incoming>Flow_Correcciones</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NuevaVersion" name="Enviar nueva versión">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Reenvio</bpmn:outgoing>
    </bpmn:task>

    <!-- Revisor: evaluación con plazo de 20 días -->
    <bpmn:subProcess id="SubProcess_Evaluar" name="Evaluar manuscrito (doble ciego)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluado</bpmn:outgoing>
      <bpmn:task id="Task_Consultar" name="Consultar asignación">
        <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_Descargar" name="Descargar PDF sanitizado">
        <bpmn:incoming>Flow_S1</bpmn:incoming>
        <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_Completar" name="Completar evaluación">
        <bpmn:incoming>Flow_S2</bpmn:incoming>
        <bpmn:outgoing>Flow_S3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_EnviarEvaluacion" name="Enviar evaluación">
        <bpmn:incoming>Flow_S3</bpmn:incoming>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_S1" sourceRef="Task_Consultar" targetRef="Task_Descargar" />
      <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_Descargar" targetRef="Task_Completar" />
      <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_Completar" targetRef="Task_EnviarEvaluacion" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Plazo" name="Vencen 20 días sin evaluación"
                        cancelActivity="true" attachedToRef="SubProcess_Evaluar">
      <bpmn:outgoing>Flow_Vencido</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Plazo">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P20D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- Flujos de secuencia -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Someter" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Registrar" targetRef="Task_AdjuntarPdf" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AdjuntarPdf" targetRef="Task_Enviar" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Enviar" targetRef="Task_ValidarPdf" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ValidarPdf" targetRef="Task_AuditarNotificar" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AuditarNotificar" targetRef="Task_RevisarEnvio" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_RevisarEnvio" targetRef="Task_PasarRevision" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_PasarRevision" targetRef="Task_Asignar" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Asignar" targetRef="SubProcess_Evaluar" />
    <bpmn:sequenceFlow id="Flow_Evaluado" name="Evaluación enviada"
                       sourceRef="SubProcess_Evaluar" targetRef="Task_RevisarEvaluacion" />
    <bpmn:sequenceFlow id="Flow_Vencido" sourceRef="Boundary_Plazo" targetRef="Task_Revocar" />
    <bpmn:sequenceFlow id="Flow_Reasignar" sourceRef="Task_Revocar" targetRef="Task_Asignar" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RevisarEvaluacion" targetRef="Task_Veredicto" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Veredicto" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Aceptado" name="Aceptado"
                       sourceRef="Gateway_Decision" targetRef="End_Publicado">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decisión = ACEPTADO</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rechazado" name="Rechazado"
                       sourceRef="Gateway_Decision" targetRef="End_Rechazado">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decisión = RECHAZADO</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Correcciones" name="Requiere correcciones"
                       sourceRef="Gateway_Decision" targetRef="Task_EditarMetadatos" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_EditarMetadatos" targetRef="Task_NuevaVersion" />
    <bpmn:sequenceFlow id="Flow_Reenvio" sourceRef="Task_NuevaVersion" targetRef="Task_ValidarPdf" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Editorial">
    <bpmndi:BPMNPlane id="Plane_Editorial" bpmnElement="Collaboration_Editorial">

      <bpmndi:BPMNShape id="Participant_Editorial_di" bpmnElement="Participant_Editorial" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2340" height="680" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Autor_di" bpmnElement="Lane_Autor" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2310" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_di" bpmnElement="Lane_Sistema" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="2310" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Editor_di" bpmnElement="Lane_Editor" isHorizontal="true">
        <dc:Bounds x="190" y="360" width="2310" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Revisor_di" bpmnElement="Lane_Revisor" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="2310" height="260" />
      </bpmndi:BPMNShape>

      <!-- Autor -->
      <bpmndi:BPMNShape id="Start_Someter_di" bpmnElement="Start_Someter">
        <dc:Bounds x="222" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="200" y="175" width="80" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Registrar_di" bpmnElement="Task_Registrar">
        <dc:Bounds x="300" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AdjuntarPdf_di" bpmnElement="Task_AdjuntarPdf">
        <dc:Bounds x="440" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Enviar_di" bpmnElement="Task_Enviar">
        <dc:Bounds x="580" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EditarMetadatos_di" bpmnElement="Task_EditarMetadatos">
        <dc:Bounds x="2165" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NuevaVersion_di" bpmnElement="Task_NuevaVersion">
        <dc:Bounds x="2305" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Sistema -->
      <bpmndi:BPMNShape id="Task_ValidarPdf_di" bpmnElement="Task_ValidarPdf">
        <dc:Bounds x="720" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuditarNotificar_di" bpmnElement="Task_AuditarNotificar">
        <dc:Bounds x="860" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Editor -->
      <bpmndi:BPMNShape id="Task_RevisarEnvio_di" bpmnElement="Task_RevisarEnvio">
        <dc:Bounds x="1000" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PasarRevision_di" bpmnElement="Task_PasarRevision">
        <dc:Bounds x="1140" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Asignar_di" bpmnElement="Task_Asignar">
        <dc:Bounds x="1280" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Revocar_di" bpmnElement="Task_Revocar">
        <dc:Bounds x="1480" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RevisarEvaluacion_di" bpmnElement="Task_RevisarEvaluacion">
        <dc:Bounds x="1900" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Veredicto_di" bpmnElement="Task_Veredicto">
        <dc:Bounds x="2040" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="2190" y="405" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="2140" y="388" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Publicado_di" bpmnElement="End_Publicado">
        <dc:Bounds x="2290" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2332" y="372" width="150" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rechazado_di" bpmnElement="End_Rechazado">
        <dc:Bounds x="2290" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2332" y="452" width="150" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Revisor -->
      <bpmndi:BPMNShape id="SubProcess_Evaluar_di" bpmnElement="SubProcess_Evaluar" isExpanded="true">
        <dc:Bounds x="1380" y="530" width="560" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Consultar_di" bpmnElement="Task_Consultar">
        <dc:Bounds x="1410" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Descargar_di" bpmnElement="Task_Descargar">
        <dc:Bounds x="1540" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Completar_di" bpmnElement="Task_Completar">
        <dc:Bounds x="1670" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnviarEvaluacion_di" bpmnElement="Task_EnviarEvaluacion">
        <dc:Bounds x="1800" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Plazo_di" bpmnElement="Boundary_Plazo">
        <dc:Bounds x="1512" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1556" y="480" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Flujos -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="258" y="150" /><di:waypoint x="300" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="400" y="150" /><di:waypoint x="440" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="540" y="150" /><di:waypoint x="580" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="680" y="150" /><di:waypoint x="770" y="150" /><di:waypoint x="770" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="820" y="290" /><di:waypoint x="860" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="960" y="290" /><di:waypoint x="1050" y="290" /><di:waypoint x="1050" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1100" y="430" /><di:waypoint x="1140" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1240" y="430" /><di:waypoint x="1280" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1330" y="470" /><di:waypoint x="1330" y="615" /><di:waypoint x="1380" y="615" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Evaluado_di" bpmnElement="Flow_Evaluado">
        <di:waypoint x="1940" y="615" /><di:waypoint x="1950" y="615" /><di:waypoint x="1950" y="470" />
        <bpmndi:BPMNLabel><dc:Bounds x="1958" y="505" width="70" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Vencido_di" bpmnElement="Flow_Vencido">
        <di:waypoint x="1530" y="512" /><di:waypoint x="1530" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reasignar_di" bpmnElement="Flow_Reasignar">
        <di:waypoint x="1480" y="430" /><di:waypoint x="1380" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="2000" y="430" /><di:waypoint x="2040" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="2140" y="430" /><di:waypoint x="2190" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Aceptado_di" bpmnElement="Flow_Aceptado">
        <di:waypoint x="2240" y="430" /><di:waypoint x="2308" y="430" /><di:waypoint x="2308" y="408" />
        <bpmndi:BPMNLabel><dc:Bounds x="2246" y="412" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rechazado_di" bpmnElement="Flow_Rechazado">
        <di:waypoint x="2215" y="455" /><di:waypoint x="2215" y="470" /><di:waypoint x="2290" y="470" />
        <bpmndi:BPMNLabel><dc:Bounds x="2222" y="472" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Correcciones_di" bpmnElement="Flow_Correcciones">
        <di:waypoint x="2215" y="405" /><di:waypoint x="2215" y="190" />
        <bpmndi:BPMNLabel><dc:Bounds x="2222" y="290" width="70" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="2265" y="150" /><di:waypoint x="2305" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reenvio_di" bpmnElement="Flow_Reenvio">
        <di:waypoint x="2355" y="110" /><di:waypoint x="2355" y="96" /><di:waypoint x="770" y="96" /><di:waypoint x="770" y="250" />
      </bpmndi:BPMNEdge>

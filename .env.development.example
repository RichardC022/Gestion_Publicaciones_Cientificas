# Variables de entorno para desarrollo local (sin TLS ni SMTP reales).
#
# Uso:
#   cp .env.development.example .env
#   chmod 600 .env
#
# No usar estos valores en producción. Para producción parte de `.env.example`.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-secret-key-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# PostgreSQL
POSTGRES_DB=PROYECTO_GPC
POSTGRES_USER=boot
POSTGRES_PASSWORD=gpc_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Seguridad y sesión
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=0

# PDF y almacenamiento
MAX_PDF_SIZE_MB=50
NGINX_CLIENT_MAX_BODY_SIZE=60m
MEDIA_ROOT=/data/media

# Respaldo
BACKUP_ROOT=/backups
RETENTION_DAYS=30

# Zona horaria institucional
TZ=America/Guayaquil

# Correo (en desarrollo Django imprime los correos en consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=noreply@unl.edu.ec
EMAIL_HOST_PASSWORD=dev-password
DEFAULT_FROM_EMAIL=noreply@unl.edu.ec

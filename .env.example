# Django
# Genera una clave nueva, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-esta-clave-por-una-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL)
DB_NAME=PROYECTO_GPC
DB_USER=boot
DB_PASSWORD=cambia-esta-contrasena
# DB_HOST=db funciona dentro de Docker Compose.
# Para ejecutar manage.py fuera de Docker usa 127.0.0.1 y DB_PORT=5433.
DB_HOST=db
DB_PORT=5432

# Email (por defecto imprime los correos en consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@unl.edu.ec

# Variables de entorno del sistema.
#
# Copia este archivo como `.env`, ajusta los valores del entorno y protege el archivo:
#   cp .env.example .env
#   chmod 600 .env
#
# No versiones `.env` ni secretos reales.

# Django
# En Fase 0 el proyecto usa config.settings. TSK-10 lo cambiará a
# config.settings.production cuando se cree el paquete de settings.
# DEBUG=1 solo para desarrollo local; en producción debe ser 0.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=gpc.unl.edu.ec,localhost
CSRF_TRUSTED_ORIGINS=https://gpc.unl.edu.ec

# PostgreSQL
POSTGRES_DB=gpc
POSTGRES_USER=gpc_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Seguridad y sesión
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SESSION_IDLE_MINUTES=30

# PDF y almacenamiento
MAX_PDF_SIZE_MB=50
NGINX_CLIENT_MAX_BODY_SIZE=60m
MEDIA_ROOT=/data/media

# Respaldo
# BACKUP_ROOT debe ser una ruta absoluta fuera del repositorio y de /data/media.
BACKUP_ROOT=/backups
RETENTION_DAYS=30

# Zona horaria institucional
TZ=America/Guayaquil

# Correo institucional
EMAIL_HOST=smtp.institucional.edu.ec
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=notificaciones@unl.edu.ec
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=notificaciones@unl.edu.ec
